# 複製這個檔案並改名為 .env，填入你的資料
# 本機執行 bot.py 時請用獨立的 Discord 機器人 Token，不要和 shams-bot 共用（斜線指令會互相覆蓋）
DISCORD_TOKEN=貼上你的Discord機器人Token
CHANNEL_ID=要發消息的頻道ID

# 每幾秒檢查一次比分、異動和新聞
CHECK_SECONDS=60

# 即時比分（開賽、每節結束、終場）只在季後賽、附加賽、明星賽、NBA 盃淘汰賽發送；
# 例行賽、熱身賽改成當天全部比賽結束後發一則整天比分
# 即時比分只追蹤哪些球隊（ESPN 縮寫，逗號分隔，例如 LAL,GS,NY,SA,NO,UTAH,WSH）；留空 = 全部球隊
# 這個設定也會套用到簽約 / 交易通知
FOLLOW_TEAMS=

# 要推送的異動類型：trade 交易、sign 簽約/續約、claim 讓渡認領、waive 釋出、
# option 合約選項、coach 教練/球團人事、gleague 下放/召回發展聯盟
TX_TYPES=trade,sign,claim
# 是否略過雙向合約、Exhibit 10 合約
SKIP_MINOR_DEALS=true

# 每幾分鐘檢查一次年度獎項（MVP、DPOY、最佳陣容、NBA 盃 MVP…，清單自動更新）
AWARD_CHECK_MINUTES=30

# 要推送的 ESPN 新聞類型：HeadlineNews（重大新聞），可再加 Story,Recap,Preview,Media
# Shams Charania 的新聞一律排除，交給 shams-bot 發
NEWS_TYPES=HeadlineNews
